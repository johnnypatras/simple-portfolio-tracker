# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*

# env files
.env*
!.env.example
!.env.remote.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling / local-only
.worktrees/
.serena/
.claude/
.firecrawl/
.playwright-mcp/
CLAUDE.md
supabase/.temp/
supabase/.branches/
.audit-report.md

# one-off scripts and debug utilities
_*.mjs

# screenshots and generated docs
*.png
*.pdf
!public/**/*.png

# database backups (keep these outside the repo)
*.sql
!supabase/migrations/*.sql
backup_*.json

# spreadsheets
*.xlsx

# Archived migrations (local reference only, contain old secrets)
supabase/migrations-archive/

# MCP / IDE configs (contain org-specific URLs)
.mcp.json
.vscode/
opencode.json
slate.json

# database backups from push-data script
backups/
coverage/
