# ─── Supabase ────────────────────────────────────────────
# Create a project at https://supabase.com and copy these from
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── CoinGecko (optional) ────────────────────────────────
# Free tier works without a key, but rate limits are tight.
# Get one at https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# ─── Sentry (optional, but CI build step expects these) ──
# Create a project at https://sentry.io and copy the DSN from
# Project Settings → Client Keys (DSN).
# - NEXT_PUBLIC_SENTRY_DSN is the client-side DSN (browser bundle).
# - SENTRY_DSN is the server/edge runtime DSN — typically the same value.
# - SENTRY_AUTH_TOKEN is for source-map uploads at build time; lives in
#   .env.sentry-build-plugin locally and is set as a repo secret in CI.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# SENTRY_AUTH_TOKEN is loaded from .env.sentry-build-plugin — not needed here.
