{
  "name": "simple-portfolio-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/sync-db.sh && next dev --turbopack",
    "dev:skip-sync": "echo '⚠ Skipping sync — using existing local data.' && next dev --turbopack",
    "dev:edge": "supabase functions serve daily-snapshot --env-file .env.local",
    "sync": "bash scripts/sync-db.sh",
    "db:push-schema": "bash scripts/push-schema.sh",
    "db:push-data": "bash scripts/push-data.sh",
    "db:restore-backup": "bash scripts/push-data.sh --restore",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor && vitest run --project integration && supabase stop",
    "test:all": "npm test && npm run test:component && npm run test:integration",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --project component --coverage",
    "test:coverage:full": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor && vitest run --project unit --project component --project integration --coverage && supabase stop"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.51.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cmdk": "^1.1.1",
    "focus-trap-react": "^12.0.1",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^29.1.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.0.18"
  }
}
